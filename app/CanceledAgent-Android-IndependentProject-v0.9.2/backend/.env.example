# Optional shared backend credential, necessary when exposing endpoints beyond localhost.
# If configured, save the exact value in Android Settings > Backend access token.
AGENT_BACKEND_TOKEN=

# Self-hosted OpenAI-compatible model, or hosted HTTPS provider.
# The local model endpoint may use HTTP only on 127.0.0.1/localhost.
AGENT_AI_ENDPOINT=https://inference.asicloud.cudos.org/v1/chat/completions
AGENT_AI_MODEL=
AGENT_AI_KEY=

# Optional secondary provider. Primary errors cause fallback, never Perchance.
AGENT_AI_FALLBACK_ENDPOINT=
AGENT_AI_FALLBACK_MODEL=
AGENT_AI_FALLBACK_KEY=

AGENT_DB_PATH=./agent-rooms.db
