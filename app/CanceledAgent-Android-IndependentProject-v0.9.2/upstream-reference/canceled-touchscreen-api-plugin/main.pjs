    function sizeOv() { if (!wrap || !ovCanvas) return; try { ovCanvas.width = wrap.clientWidth; ovCanvas.height = wrap.clientHeight; } catch (e) {} }
    if (wrap) { try { new ResizeObserver(sizeOv).observe(wrap); } catch (e5) {} }
    sizeOv();
    function dotOnOverlay(x, y, color) {
