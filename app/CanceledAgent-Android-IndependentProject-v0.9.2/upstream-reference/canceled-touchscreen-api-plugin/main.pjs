          else { log("frame-mode", { mode: "cross-origin-postMessage", note: "clicks need the receiver in the framed page" }); }
        }, 900);
      });
    } catch (e7) {} }
    setTimeout(hookFrameDoc, 2500);
    pmClick.onclick = function () { let how = realClick(50, 50, "left"); rippleOnOverlay(50, 50, "#ff0"); log("msg-click", { via: how }); };
    pmScroll.onclick = function () { let d = sameDoc(); if (d) { try { d.defaultView.scrollBy(0, 200); log("scroll", { via: "real" }); return; } catch (e) {} } fwd({ kind: "wheel", dy: 200 }); };
    pmHi.onclick = function () { let how = realType("Hi"); log("type", { via: how }); };
    noDispB.onclick = async function () {
      if (!fr) { log("no-frame", { note: "frameless instance" }); return; }
      realmEl.textContent = "rebuilding as srcdoc clone…";
      try {
        if (S.genName) {
          let r = await fetch("https://perchance.org/api/getGeneratorsAndDependencies?generatorNames=" + encodeURIComponent(S.genName)).then(function (x) { return x.json(); });
          let g = r.generators && r.generators[S.genName];
          if (!g) throw new Error("generator not found");
          let code = g.code || "", htmlSrc = g.html || "";
          let doc = "<!DOCTYPE html><html><head><base href=\"https://perchance.org/" + S.genName + "\"><style>body{margin:0}</style></head><body>" + htmlSrc + "<script>" + code.replace(/<\/script/gi, "<\\/script") + "<\/script></body></html>";
          fr.removeAttribute("src"); fr.srcdoc = doc;
          setTimeout(hookFrameDoc, 1200);
          log("srcdoc-rebuild", { gen: S.genName, bytes: doc.length });
          realmEl.textContent = "srcdoc clone live for generator '" + S.genName + "' (" + doc.length + " bytes). Clicks/keys now dispatch for real into the clone; cross-origin nav is shown here as rebuilds; postMessages still captured below.";
        } else {
          let txt = await fetch(S.embed).then(function (x) { return x.text(); });
          let doc = "<base href=\"" + S.embed + "\">" + txt;
          fr.removeAttribute("src"); fr.srcdoc = doc;
          setTimeout(hookFrameDoc, 1200);
          log("srcdoc-rebuild", { url: S.embed });
          realmEl.textContent = "srcdoc clone live (" + doc.length + " bytes). Sites with frame/CSP/CORS limits may render partially; that is a browser security rule, not a plugin bug.";
        }
      } catch (e) { realmEl.textContent = "rebuild failed: " + (e && e.message || e) + "\nUse a perchance generator target for full rebuilds."; log("rebuild-fail", { err: String(e && e.message || e) }); }
    };
    recB.onclick = function () { S.recording = !S.recording; recB.textContent = S.recording ? "Stop recording" : "Record macro"; recInfo.textContent = S.recording ? "REC " + S.macro.length : "macro " + S.macro.length; log("macro-record", { on: S.recording }); };
    playB.onclick = function () { log("macro-replay", { n: S.macro.length }); execArr(S.macro.slice()); };
    clrB.onclick = function () { S.macro = []; recInfo.textContent = "macro 0"; log("macro-clear", {}); };
