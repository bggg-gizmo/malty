    }
    function rippleOnOverlay(x, y, color) {
      if (!ov) return;
      let s = document.createElement("div");
      s.style.cssText = "position:absolute;width:34px;height:34px;border-radius:50%;border:3px solid " + (color || "#ff0") + ";transform:translate(-50%,-50%);pointer-events:none;z-index:4;";
      s.style.left = x + "%"; s.style.top = y + "%";
      ov.appendChild(s); setTimeout(function () { s.remove(); }, 650);
    }
    function drawCur() {
      cur.style.left = S.mouse.x + "%"; cur.style.top = S.mouse.y + "%";
      if (ovCur) { ovCur.style.left = S.mouse.x + "%"; ovCur.style.top = S.mouse.y + "%"; }
      mInfo.textContent = "x:" + Math.round(S.mouse.x) + " y:" + Math.round(S.mouse.y) + " held:" + heldLabel();
    }
    drawCur();
    function stepMove(x, y) { S.mouse.x = Math.max(0, Math.min(100, x)); S.mouse.y = Math.max(0, Math.min(100, y)); drawCur(); dotOnOverlay(S.mouse.x, S.mouse.y, (S.held.left || S.held.middle || S.held.right) ? "rgba(255,136,0,.7)" : "rgba(0,255,255,.55)"); fwd({ kind: "mouse", how: (S.held.left || S.held.middle || S.held.right) ? "drag" : "hover", x: Math.round(S.mouse.x * 10) / 10, y: Math.round(S.mouse.y * 10) / 10, held: heldLabel() }); }
    async function traceTo(tx, ty) { tx = Math.max(0, Math.min(100, tx)); ty = Math.max(0, Math.min(100, ty)); let sx = S.mouse.x, sy = S.mouse.y; let dist = Math.hypot(tx - sx, ty - sy); let steps = Math.max(2, Math.min(90, Math.round(dist * 1.6))); for (let i = 1; i <= steps; i++) { stepMove(sx + (tx - sx) * i / steps, sy + (ty - sy) * i / steps); await new Promise(function (r) { setTimeout(r, 28); }); } log("trace-done", { x: Math.round(S.mouse.x), y: Math.round(S.mouse.y) }); record({ op: "trace", x: Math.round(tx), y: Math.round(ty) }); }
    function mDown(btn) { if (S.held[btn]) return; S.held[btn] = true; drawCur(); rippleOnOverlay(S.mouse.x, S.mouse.y, "#f80"); log("mousedown", { button: btn }); fwd({ kind: "mousedown", button: btn, x: Math.round(S.mouse.x), y: Math.round(S.mouse.y) }); record({ op: "down", button: btn }); }
    function mUp(btn) { if (!S.held[btn]) return; S.held[btn] = false; drawCur(); log("mouseup", { button: btn }); fwd({ kind: "mouseup", button: btn, x: Math.round(S.mouse.x), y: Math.round(S.mouse.y) }); record({ op: "up", button: btn }); }
    async function mClick(btn, n) { n = n || 1; for (let i = 0; i < n; i++) { mDown(btn); await new Promise(function (r) { setTimeout(r, 70); }); mUp(btn); if (i < n - 1) await new Promise(function (r) { setTimeout(r, 90); }); } let how = realClick(S.mouse.x, S.mouse.y, btn, n); rippleOnOverlay(S.mouse.x, S.mouse.y, "#ff0"); log("click", { button: btn, count: n, via: how }); record({ op: "click", button: btn, count: n }); }
    let lastT = null;
    track.addEventListener("pointerdown", function (e) { try { track.setPointerCapture(e.pointerId); } catch (x) {} lastT = { x: e.clientX, y: e.clientY }; });
    track.addEventListener("pointermove", function (e) { if (!lastT) return; let dx = (e.clientX - lastT.x) / track.clientWidth * 40, dy = (e.clientY - lastT.y) / track.clientHeight * 40; lastT = { x: e.clientX, y: e.clientY }; stepMove(S.mouse.x + dx, S.mouse.y + dy); });
    track.addEventListener("pointerup", function () { lastT = null; });
    stage.addEventListener("pointerdown", async function (e) { let r = stage.getBoundingClientRect(); await traceTo((e.clientX - r.left) / r.width * 100, (e.clientY - r.top) / r.height * 100); mClick("left", 1); });
    let mRow = document.createElement("div");
    mRow.style.cssText = "display:flex;gap:6px;margin-top:6px;flex-wrap:wrap;";
    [["Left","left"],["Middle","middle"],["Right","right"]].forEach(function (pair) { let b = mkBtn(pair[0]); b.onclick = function () { mClick(pair[1], 1); }; mRow.appendChild(b); });
    let dbl = mkBtn("2x L"); dbl.onclick = function () { mClick("left", 2); }; mRow.appendChild(dbl);
    let dblR = mkBtn("2x R"); dblR.onclick = function () { mClick("right", 2); }; mRow.appendChild(dblR);
    let triL = mkBtn("3x L"); triL.onclick = function () { mClick("left", 3); }; mRow.appendChild(triL);
    let triR = mkBtn("3x R"); triR.onclick = function () { mClick("right", 3); }; mRow.appendChild(triR);
    [["Hold L","left"],["Hold M","middle"],["Hold R","right"]].forEach(function (pair) { let b = mkBtn(pair[0]); b.onclick = function () { mDown(pair[1]); }; mRow.appendChild(b); });
    [["Rel L","left"],["Rel M","middle"],["Rel R","right"]].forEach(function (pair) { let b = mkBtn(pair[0]); b.onclick = function () { mUp(pair[1]); }; mRow.appendChild(b); });
    let wU = mkBtn("wheel -"); wU.onclick = function () { log("wheel", { dy: -100 }); fwd({ kind: "wheel", dy: -100 }); record({ op: "wheel", dy: -100 }); };
    let wD = mkBtn("wheel +"); wD.onclick = function () { log("wheel", { dy: 100 }); fwd({ kind: "wheel", dy: 100 }); record({ op: "wheel", dy: 100 }); };
    mRow.appendChild(wU); mRow.appendChild(wD); pMouse.appendChild(mRow);
    let ovClearB = mkBtn("Clear overlay trails");
    ovClearB.style.marginTop = "6px";
    ovClearB.onclick = function () { try { octx.clearRect(0, 0, ovCanvas.width, ovCanvas.height); } catch (e) {} };
    pMouse.appendChild(ovClearB);
    rightCol.appendChild(pMouse);
    async function aiTranslate() {
      aiOut.textContent = "translating…";
      let instruction = "Translate this touchscreen instruction into a JSON array of actions. Actions: {\"op\":\"trace\",\"x\":0-100,\"y\":0-100}, {\"op\":\"down\",\"button\":\"left\"}, {\"op\":\"up\",\"button\":\"left\"}, {\"op\":\"click\",\"button\":\"left\",\"count\":1}, {\"op\":\"type\",\"text\":\"...\"}, {\"op\":\"key\",\"key\":\"Enter\"}, {\"op\":\"wheel\",\"dy\":100}. Reply ONLY JSON array. Instruction: " + aiIn.value;
      try {
        let gt = null;
        try { gt = root.generateText; } catch (e0) {}
        if (!gt) { try { gt = window.generateText; } catch (e0b) {} }
        if (gt) {
          let plan = await gt(instruction);
          aiOut.textContent = String(plan);
        } else throw 0;
      } catch (e) {
        let t = aiIn.value.toLowerCase(); let arr = [];
        if (t.indexOf("login") >= 0) arr.push({ op: "trace", x: 50, y: 30 });
        else arr.push({ op: "trace", x: 50, y: 50 });
        let mt = aiIn.value.match(/type\\s+([^,]+)/i);
        if (mt) arr.push({ op: "type", text: mt[1].trim() });
        if (t.indexOf("submit") >= 0 || t.indexOf("click") >= 0) arr.push({ op: "click", button: "left", count: 1 });
        if (t.indexOf("scroll") >= 0) arr.push({ op: "wheel", dy: 200 });
        aiOut.textContent = JSON.stringify(arr);
      }
      log("ai-plan", { plan: aiOut.textContent.slice(0, 200) });
    }
    async function execArr(arr) {
      for (let a of arr) {
        if (a.op === "trace") await traceTo(a.x, a.y);
        else if (a.op === "down") mDown(a.button || "left");
        else if (a.op === "up") mUp(a.button || "left");
        else if (a.op === "click") await mClick(a.button || "left", a.count || 1);
        else if (a.op === "type") { let how = realType(String(a.text)); for (let ch of String(a.text)) dispatchKey(ch); log("type", { via: how }); }
        else if (a.op === "key") dispatchKey(a.key);
        else if (a.op === "wheel") { fwd({ kind: "wheel", dy: a.dy || 100 }); }
        await new Promise(function (r) { setTimeout(r, 350); });
      }
    }
    aiRun.onclick = aiTranslate;
    aiExec.onclick = async function () {
      let t = aiOut.textContent, arr;
      try { arr = JSON.parse(t.slice(t.indexOf("["), t.lastIndexOf("]") + 1)); } catch (e) { return; }
      execArr(arr);
    };
    function loadTarget(t) {
      if (!fr) { log("no-frame", { note: "frameless instance" }); return; }
      t = String(t).trim(); if (!t) return;
      let ni = toEmbedUrl(t); S.embed = ni.embed; S.genName = ni.genName; S.isGen = ni.isGen;
      fr.removeAttribute("srcdoc"); fr.src = S.embed; log("iframe-load", { u: S.embed });
    }
    loadB.onclick = function () { loadTarget(urlIn.value); };
    selfB.onclick = function () { let u = gPid ? "https://" + gPid + ".perchance.org/" + gName + "#tbembed" : "https://null.perchance.org/" + gName + "#tbembed"; urlIn.value = u; loadTarget(u); };
    doorsB.onclick = function () { let u = "https://perchance.org/i-am-canceled-presents-macrohard-doors-os"; urlIn.value = u; loadTarget(u); };
    let ovOn = false;
    if (!ov) ovB.textContent = "Overlay: n/a (no frame)";
    ovB.onclick = function () { if (!ov) return; ovOn = !ovOn; ov.style.pointerEvents = ovOn ? "auto" : "none"; ovB.textContent = "Overlay capture: " + (ovOn ? "ON" : "OFF"); log("overlay", { on: ovOn }); };
    function ovPct(e) { let r = wrap.getBoundingClientRect(); return { x: (e.clientX - r.left) / r.width * 100, y: (e.clientY - r.top) / r.height * 100 }; }
    if (ov) {
    ov.addEventListener("pointerdown", async function (e) {
      let p = ovPct(e);
      log("iframe-touch", { phase: "start", x: Math.round(p.x), y: Math.round(p.y) });
      await traceTo(p.x, p.y);
      let how = realClick(p.x, p.y, "left");
      rippleOnOverlay(p.x, p.y, "#ff0");
      log("iframe-tap", { via: how });
      record({ op: "trace", x: Math.round(p.x), y: Math.round(p.y) });
      record({ op: "click", button: "left", count: 1 });
      fwd({ kind: "touch", phase: "start" });
    });
    ov.addEventListener("pointermove", function (e) { if (e.buttons) { let p = ovPct(e); dotOnOverlay(p.x, p.y, "rgba(255,136,0,.7)"); fwd({ kind: "touch", phase: "move" }); } });
    ov.addEventListener("pointerup", function (e) { fwd({ kind: "touch", phase: "end" }); });
    ov.addEventListener("wheel", function (e) { e.preventDefault(); fwd({ kind: "wheel", dy: e.deltaY }); }, { passive: false });
    }
    function hookFrameDoc() {
      let d = sameDoc();
      if (!d || d.__tbHooked) return;
      try {
        d.__tbHooked = true;
        d.addEventListener("click", function (e) {
          let r = fr.getBoundingClientRect();
          let x = (e.clientX / r.width) * 100, y = (e.clientY / r.height) * 100;
          log("iframe-click", { x: Math.round(x), y: Math.round(y) });
          dotOnOverlay(x, y, "rgba(255,255,0,.8)"); rippleOnOverlay(x, y, "#ff0");
          if (!e.isTrusted) return;
          record({ op: "trace", x: Math.round(x), y: Math.round(y) });
          record({ op: "click", button: "left", count: 1 });
        });
        let lastH = 0;
        d.addEventListener("pointermove", function (e) {
          let now = Date.now();
          if (now - lastH < 120) return;
          lastH = now;
          let r = fr.getBoundingClientRect();
          dotOnOverlay((e.clientX / r.width) * 100, (e.clientY / r.height) * 100, "rgba(0,255,255,.4)");
        });
        d.addEventListener("keydown", function (e) { log("iframe-key", { key: e.key }); });
        log("frame-hook", { ok: true });
      } catch (e) {}
    }
    if (fr) { try { fr.addEventListener("load", hookFrameDoc); } catch (e6) {} }
    if (fr) { try {
      fr.addEventListener("load", function () {
        setTimeout(function () {
